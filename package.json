{
  "name": "petrobolos-games-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static website for Petrobolos Games built with Eleventy and Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i src/styles/tailwind.css -o src/static/css/tailwind.css --config tailwind.config.js --minify",
    "build": "npm run build:css && npx @11ty/eleventy",
    "serve": "npm run build:css && npx @11ty/eleventy --serve",
    "clean": "rimraf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@tailwindcss/cli": "^4.2.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.2"
  }
}
