{
  "name": "petrobolos-games-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static website for Petrobolos Games built with Eleventy and Tailwind CSS",
  "scripts": {
    "build:css": "bash scripts/build-tailwind.sh",
    "build": "npm run build:css && npx @11ty/eleventy",
    "serve": "npm run build:css && npx @11ty/eleventy --serve",
    "clean": "rimraf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "rimraf": "^5.0.5"
  }
}
