{% macro page_intro(title, subtitle) %}
<header class="mb-10">
  <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900">{{ title }}</h1>
  <p class="mt-3 text-slate-600 max-w-3xl">{{ subtitle }}</p>
</header>
{% endmacro %}

{% macro mission_section(title, paragraphs, image) %}
<div class="grid gap-10 lg:grid-cols-2 items-start">
  <div>
    <h2 class="text-2xl font-bold text-slate-900">{{ title }}</h2>
    {% for paragraph in paragraphs %}
    <p class="mt-3 text-slate-700">{{ paragraph }}</p>
    {% endfor %}
  </div>
  <div>
    <img src="{{ image.src }}" alt="{{ image.alt }}" class="w-full h-auto rounded-lg shadow">
  </div>
</div>
{% endmacro %}

{% macro team_section(team_members, heading='Our Team') %}
<div class="mt-16">
  <h2 class="text-2xl font-bold text-slate-900">{{ heading }}</h2>
  <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {% for member in team_members %}
    <article id="{{ member.id }}" class="bg-white rounded-lg shadow-sm ring-1 ring-slate-200 p-6">
      <img src="{{ member.image }}" alt="Photo of {{ member.name }}" class="w-24 h-24 rounded-full object-cover">
      <h3 class="mt-4 text-lg font-semibold text-slate-900">{{ member.name }}</h3>
      <p class="text-sm text-slate-600">{{ member.role }}</p>
      <p class="mt-3 text-sm text-slate-700">{{ member.bio }}</p>
    </article>
    {% endfor %}
  </div>
</div>
{% endmacro %}
