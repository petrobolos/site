{% macro page_header(config) %}
<section class="relative overflow-hidden bg-slate-950 py-14">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/4 top-0 h-52 w-52 rounded-full bg-primary-500/20 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 h-56 w-56 rounded-full bg-cyan-400/15 blur-3xl"></div>
  </div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    {% if config.eyebrow %}
    <p class="text-xs font-semibold uppercase tracking-wider text-primary-200">{{ config.eyebrow }}</p>
    {% endif %}
    <h1 class="{% if config.eyebrow %}mt-3 {% endif %}max-w-3xl text-4xl font-extrabold tracking-tight text-white md:text-5xl">{{ config.title }}</h1>
    {% if config.subtitle %}
    <p class="mt-4 max-w-2xl text-slate-300">{{ config.subtitle }}</p>
    {% endif %}
  </div>
</section>
{% endmacro %}
