{% macro project_hero(project) %}
<section class="relative overflow-hidden">
  <div class="relative isolate">
    <img
      src="{{ project.hero.background }}"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover blur-sm scale-105"
    >
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/90 via-slate-900/60 to-slate-900"></div>

    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-6 py-20 md:grid-cols-2 md:py-28">
      <div class="z-10 text-center md:text-left">
        {% if project.hero.eyebrow %}
        <p class="inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-1 text-sm font-medium text-slate-100">
          {{ project.hero.eyebrow }}
        </p>
        {% endif %}
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-white md:text-6xl">{{ project.title }}</h1>
        <p class="mt-4 text-lg text-slate-200 md:text-xl">{{ project.subtitle }}</p>
        <p class="mt-6 max-w-2xl text-slate-200">{{ project.hero.description }}</p>

        {% if project.hero.ctas %}
        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row md:items-start">
          {% for cta in project.hero.ctas %}
          <a href="{{ cta.href }}" class="inline-flex items-center rounded-md px-6 py-3 text-sm font-semibold {{ cta.classes }}">
            {{ cta.label }}
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="z-10 mx-auto w-full max-w-md md:justify-self-end">
        <div class="rounded-2xl border border-white/20 bg-slate-950/70 p-6 shadow-2xl backdrop-blur-sm">
          <img src="{{ project.hero.logo.src }}" alt="{{ project.hero.logo.alt }}" class="mx-auto w-56 object-contain sm:w-72">
          {% if project.hero.stats %}
          <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
            {% for stat in project.hero.stats %}
            <div class="rounded-lg bg-slate-900/70 p-3">
              <dt class="text-slate-400">{{ stat.label }}</dt>
              <dd class="mt-1 font-semibold {{ stat.valueClass or 'text-white' }}">{{ stat.value }}</dd>
            </div>
            {% endfor %}
          </dl>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endmacro %}

{% macro feature_grid(features) %}
<section id="overview" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-3">
    {% for feature in features %}
    <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">{{ feature.title }}</h2>
      <p class="mt-3 text-slate-700 dark:text-slate-300">{{ feature.description }}</p>
    </article>
    {% endfor %}
  </div>
</section>
{% endmacro %}

{% macro screenshots_section(section) %}
<section id="{{ section.id or 'screenshots' }}" class="bg-slate-900 py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold text-white">{{ section.title }}</h2>
        <p class="mt-2 text-slate-300">{{ section.subtitle }}</p>
      </div>
      {% if section.action %}
      <a href="{{ section.action.href }}" class="text-sm font-semibold text-primary-300 hover:text-primary-200">{{ section.action.label }}</a>
      {% endif %}
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {% for item in section.items %}
      {% if item.type == 'image' %}
      <figure class="overflow-hidden rounded-2xl border border-white/10 {{ item.wrapperClass or '' }}">
        <img src="{{ item.src }}" alt="{{ item.alt }}" class="h-full w-full object-cover">
      </figure>
      {% else %}
      <div class="flex min-h-[220px] items-center justify-center rounded-2xl border border-dashed border-slate-600 bg-slate-800/50 p-6 text-center text-slate-300 {{ item.wrapperClass or '' }}">
        {{ item.text }}
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endmacro %}

{% macro media_section(section) %}
<section id="{{ section.id or 'media' }}" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">{{ section.title }}</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-300">{{ section.subtitle }}</p>
      <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 shadow-sm dark:border-slate-800">
        <div class="aspect-video">
          <iframe
            class="h-full w-full"
            src="{{ section.embed.url }}"
            title="{{ section.embed.title }}"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      {% if section.helper %}
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{{ section.helper }}</p>
      {% endif %}
    </div>

    {% if section.slots %}
    <aside class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{{ section.slots.title }}</h3>
      <ul class="mt-4 space-y-3 text-sm text-slate-700 dark:text-slate-300">
        {% for slot in section.slots.items %}
        <li class="rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-800">{{ slot }}</li>
        {% endfor %}
      </ul>
    </aside>
    {% endif %}
  </div>
</section>
{% endmacro %}

{% macro platform_icon(src, alt) %}
<span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">
  <img src="{{ src }}" alt="{{ alt }}" class="h-5 w-5 object-contain dark:invert" loading="lazy" decoding="async">
</span>
{% endmacro %}

{% macro platform_links(platform_entry, storefronts) %}
{% if platform_entry.stores %}
<div class="mt-4 flex flex-wrap gap-2">
  {% for store in platform_entry.stores %}
  {% set meta = storefronts[store.id] %}
  <a href="{{ store.url }}" class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:text-white">
    {% if meta and meta.icon %}
    <img src="{{ meta.icon }}" alt="" class="h-3.5 w-3.5 dark:invert" aria-hidden="true" loading="lazy" decoding="async">
    {% endif %}
    {{ store.label or meta.name }}
  </a>
  {% endfor %}
</div>
{% elif platform_entry.links %}
<div class="mt-4 flex flex-wrap gap-2">
  {% for link in platform_entry.links %}
    <a href="{{ link.url }}" class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:text-white">
      {{ link.label }}
    </a>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro platforms_section(section, platform_catalog, storefront_catalog) %}
<section id="{{ section.id or 'platforms' }}" class="bg-slate-100 py-16 dark:bg-slate-900/40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-slate-900 dark:text-white">{{ section.title }}</h2>
    <p class="mt-2 text-slate-600 dark:text-slate-300">{{ section.subtitle }}</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {% for entry in section.items %}
      {% set platform = platform_catalog[entry.id] %}
      <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center gap-3">
          {{ platform_icon(platform.icon, platform.name ~ ' icon') }}
          <h3 class="font-semibold text-slate-900 dark:text-white">{{ platform.name }}</h3>
        </div>

        {% if entry.description %}
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{{ entry.description }}</p>
        {% endif %}

        {% if entry.status %}
        <span class="mt-4 inline-flex rounded-full px-3 py-1 text-xs font-semibold {{ entry.status.class }}">
          {{ entry.status.label }}
        </span>
        {% endif %}

        {{ platform_links(entry, storefront_catalog) }}
      </article>
      {% endfor %}
    </div>

    <p class="mt-8 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
      {{ section.legalNotice or "All product names, logos, brands, and platform marks are property of their respective owners. Windows and Xbox are trademarks of Microsoft Corporation. macOS, iOS, and App Store are trademarks of Apple Inc. Android and Google Play are trademarks of Google LLC. Linux is the registered trademark of Linus Torvalds. PlayStation, PS4, and PS5 are registered trademarks or trademarks of Sony Interactive Entertainment Inc. Nintendo, Nintendo Switch, and Nintendo Switch 2 are trademarks of Nintendo. Steam is a trademark of Valve Corporation. Epic Games is a trademark or registered trademark of Epic Games, Inc. itch.io is a trademark of Leaf Corcoran." }}
    </p>
  </div>
</section>
{% endmacro %}
