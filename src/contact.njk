---
layout: layouts/base.njk
title: Contact
description: Get in touch with Petrobolos Games.
---
{% from "components/page-header.njk" import page_header %}

{{ page_header({
  eyebrow: "Contact",
  title: "Get in touch with the studio",
  subtitle: "Questions, collaborations, or press outreach. Drop us a line and we will get back as soon as we can."
}) }}

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
    <form
      id="contact-form"
      name="contact"
      method="POST"
      action="/contact/?success=1"
      data-netlify="true"
      data-netlify-recaptcha="true"
      netlify-honeypot="bot-field"
      class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
      aria-labelledby="contact-form-heading"
    >
      <input type="hidden" name="form-name" value="contact">
      <p class="hidden" aria-hidden="true">
        <label>Do not fill this out if you are human: <input name="bot-field" tabindex="-1" autocomplete="off"></label>
      </p>
      <h2 id="contact-form-heading" class="text-xl font-semibold text-slate-900 dark:text-white">Send us a message</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">We typically respond within 2-3 business days.</p>
      <div id="contact-success" class="mt-4 hidden rounded-md border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 dark:border-emerald-800/70 dark:bg-emerald-950/40 dark:text-emerald-300" role="status" aria-live="polite">
        Thanks, your message has been sent successfully.
      </div>
      <div id="contact-error" class="mt-4 hidden rounded-md border border-rose-300 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800 dark:border-rose-800/70 dark:bg-rose-950/40 dark:text-rose-300" role="alert">
        We could not send your message right now. Please try again in a moment.
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Name</label>
          <input id="name" name="name" type="text" required minlength="2" maxlength="80" pattern="[A-Za-zÀ-ÖØ-öø-ÿ0-9 .,'-]{2,80}" autocomplete="name" spellcheck="false" class="mt-1 block w-full rounded-md border border-slate-300 bg-white text-slate-900 focus:border-primary-500 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Email</label>
          <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" spellcheck="false" class="mt-1 block w-full rounded-md border border-slate-300 bg-white text-slate-900 focus:border-primary-500 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
        </div>
        <div class="sm:col-span-2">
          <label for="subject" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Subject</label>
          <input id="subject" name="subject" type="text" required minlength="5" maxlength="120" autocomplete="off" class="mt-1 block w-full rounded-md border border-slate-300 bg-white text-slate-900 focus:border-primary-500 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Message</label>
          <textarea id="message" name="message" rows="6" required minlength="20" maxlength="3000" autocomplete="off" class="mt-1 block w-full rounded-md border border-slate-300 bg-white text-slate-900 focus:border-primary-500 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"></textarea>
        </div>
      </div>

      <div class="mt-6">
        <div data-netlify-recaptcha="true"></div>
        <button id="contact-submit" type="submit" class="inline-flex items-center rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-500 disabled:cursor-not-allowed disabled:bg-slate-400 dark:disabled:bg-slate-600">Send message</button>
      </div>
    </form>

    <aside class="space-y-6">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">General Contact</h2>
        <p class="mt-3 text-slate-700 dark:text-slate-300">
          Email: <a href="mailto:hello@petrobolos.com" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">hello@petrobolos.com</a>
        </p>
        <p class="mt-2 text-slate-700 dark:text-slate-300">
          Press: <a href="mailto:press@petrobolos.com" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">press@petrobolos.com</a>
        </p>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Follow the Studio</h2>
        <ul class="mt-3 space-y-2 text-slate-700 dark:text-slate-300">
          <li><a href="{{ site.social.twitter }}" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">X (Twitter)</a></li>
          <li><a href="{{ site.social.facebook }}" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">Facebook</a></li>
          <li><a href="{{ site.social.linkedin }}" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">LinkedIn</a></li>
          <li><a href="{{ site.social.github }}" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">GitHub</a></li>
        </ul>
      </section>
    </aside>
  </div>
</section>

<script>
  (function () {
    const successMessage = document.getElementById('contact-success');
    const params = new URLSearchParams(window.location.search);

    if (params.get('success') === '1' && successMessage) {
      successMessage.classList.remove('hidden');
    }
  })();
</script>
