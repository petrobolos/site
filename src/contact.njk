---
layout: layouts/base.njk
title: Contact
description: Get in touch with Petrobolos Games.
---

<section class="relative overflow-hidden bg-slate-950 py-14">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute right-10 top-0 h-48 w-48 rounded-full bg-primary-500/20 blur-3xl"></div>
  </div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-extrabold tracking-tight text-white md:text-5xl">Contact</h1>
    <p class="mt-3 max-w-2xl text-slate-300">
      Questions, collaborations, or press outreach. Drop us a line and we will get back as soon as we can.
    </p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
    <form action="#" method="post" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900" aria-labelledby="contact-form-heading">
      <h2 id="contact-form-heading" class="text-xl font-semibold text-slate-900 dark:text-white">Send us a message</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">We typically respond within 2-3 business days.</p>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Name</label>
          <input id="name" name="name" type="text" required class="mt-1 block w-full rounded-md border border-slate-300 bg-white text-slate-900 focus:border-primary-500 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="mt-1 block w-full rounded-md border border-slate-300 bg-white text-slate-900 focus:border-primary-500 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
        </div>
        <div class="sm:col-span-2">
          <label for="subject" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Subject</label>
          <input id="subject" name="subject" type="text" class="mt-1 block w-full rounded-md border border-slate-300 bg-white text-slate-900 focus:border-primary-500 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="block text-sm font-medium text-slate-700 dark:text-slate-200">Message</label>
          <textarea id="message" name="message" rows="6" required class="mt-1 block w-full rounded-md border border-slate-300 bg-white text-slate-900 focus:border-primary-500 focus:ring-primary-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"></textarea>
        </div>
      </div>

      <div class="mt-6">
        <button type="submit" class="inline-flex items-center rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-500">Send message</button>
      </div>
    </form>

    <aside class="space-y-6">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">General Contact</h2>
        <p class="mt-3 text-slate-700 dark:text-slate-300">
          Email: <a href="mailto:hello@example.com" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">hello@example.com</a>
        </p>
        <p class="mt-2 text-slate-700 dark:text-slate-300">
          Press: <a href="mailto:press@example.com" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">press@example.com</a>
        </p>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Follow the Studio</h2>
        <ul class="mt-3 space-y-2 text-slate-700 dark:text-slate-300">
          <li><a href="{{ site.social.twitter }}" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">X (Twitter)</a></li>
          <li><a href="{{ site.social.facebook }}" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">Facebook</a></li>
          <li><a href="{{ site.social.linkedin }}" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">LinkedIn</a></li>
          <li><a href="{{ site.social.github }}" class="font-semibold text-primary-700 hover:text-primary-800 dark:text-primary-300">GitHub</a></li>
        </ul>
      </section>
    </aside>
  </div>
</section>
