---
layout: layouts/base.njk
title: Contact
description: Get in touch with Petrobolos Games.
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
  <header class="mb-10">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900">Contact</h1>
    <p class="mt-3 text-slate-600 max-w-2xl">Questions, feedback, or press inquiries? Reach out using the form below or the details provided.</p>
  </header>

  <div class="grid gap-12 lg:grid-cols-2">
    <form action="#" method="post" class="bg-white rounded-lg shadow-sm ring-1 ring-slate-200 p-6" aria-labelledby="contact-form-heading">
      <h2 id="contact-form-heading" class="text-xl font-semibold text-slate-900">Send us a message</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <label for="name" class="block text-sm font-medium text-slate-700">Name</label>
          <input id="name" name="name" type="text" required class="mt-1 block w-full rounded-md border-slate-300 focus:border-primary-500 focus:ring-primary-500">
        </div>
        <div class="sm:col-span-1">
          <label for="email" class="block text-sm font-medium text-slate-700">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="mt-1 block w-full rounded-md border-slate-300 focus:border-primary-500 focus:ring-primary-500">
        </div>
        <div class="sm:col-span-2">
          <label for="subject" class="block text-sm font-medium text-slate-700">Subject</label>
          <input id="subject" name="subject" type="text" class="mt-1 block w-full rounded-md border-slate-300 focus:border-primary-500 focus:ring-primary-500">
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="block text-sm font-medium text-slate-700">Message</label>
          <textarea id="message" name="message" rows="6" required class="mt-1 block w-full rounded-md border-slate-300 focus:border-primary-500 focus:ring-primary-500"></textarea>
        </div>
      </div>
      <div class="mt-6">
        <button type="submit" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-600">Send Message</button>
      </div>
    </form>

    <aside class="space-y-6">
      <section>
        <h2 class="text-xl font-semibold text-slate-900">Contact Details</h2>
        <p class="mt-2 text-slate-700">Email: <a href="mailto:hello@example.com" class="text-primary-700 hover:text-primary-800">hello@example.com</a></p>
        <p class="mt-2 text-slate-700">Press: <a href="mailto:press@example.com" class="text-primary-700 hover:text-primary-800">press@example.com</a></p>
      </section>
      <section>
        <h2 class="text-xl font-semibold text-slate-900">Follow Us</h2>
        <ul class="mt-2 space-y-2 text-slate-700">
          <li><a href="{{ site.social.twitter }}" class="text-primary-700 hover:text-primary-800">Twitter</a></li>
          <li><a href="{{ site.social.facebook }}" class="text-primary-700 hover:text-primary-800">Facebook</a></li>
          <li><a href="{{ site.social.linkedin }}" class="text-primary-700 hover:text-primary-800">LinkedIn</a></li>
          <li><a href="{{ site.social.github }}" class="text-primary-700 hover:text-primary-800">GitHub</a></li>
        </ul>
      </section>
    </aside>
  </div>
</section>
