---
layout: layouts/base.njk
title: Our Games
description: Explore games by Petrobolos Games.
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
  <header class="mb-10">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900">Our Games</h1>
    <p class="mt-3 text-slate-600 max-w-2xl">Browse a selection of titles from Petrobolos Games. Placeholder descriptions and images are used.</p>
  </header>

  <div class="grid gap-8 md:grid-cols-2">
    {% for game in games %}
    <article id="{{ game.id }}" class="bg-white rounded-lg shadow-sm ring-1 ring-slate-200 overflow-hidden">
      <img src="{{ game.image }}" alt="{{ game.title }} placeholder image" class="w-full h-60 object-cover">
      <div class="p-6">
        <h2 class="text-2xl font-bold text-slate-900">{{ game.title }}</h2>
        <p class="text-primary-700 font-medium">{{ game.subtitle }}</p>
        <p class="mt-3 text-slate-700">{{ game.description }}</p>
        <div class="mt-5">
          <a href="{{ game.url }}" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-600">Learn more</a>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
