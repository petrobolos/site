---
layout: layouts/base.njk
title: Our Games
description: Explore games by Petrobolos Games.
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 space-y-16">
  {% for game in games %}
    <div id="{{ game.id }}" class="grid md:grid-cols-2 gap-8 items-center scroll-mt-24">
      <div class="overflow-hidden rounded-lg">
        <img src="{{ game.image }}" alt="{{ game.title }}" class="w-full h-full object-cover">
      </div>
      <div>
        <h2 class="text-3xl font-extrabold text-slate-900 mb-4">{{ game.title }}</h2>
        <p class="text-slate-700 mb-4">{{ game.description }}</p>
        {% if game.features %}
          <ul class="list-disc list-inside space-y-2 mb-4">
            {% for feature in game.features %}
              <li>{{ feature }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        <a href="{{ game.url }}" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-600">Learn more</a>
      </div>
    </div>
  {% endfor %}
</section>
