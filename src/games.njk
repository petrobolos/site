---
layout: layouts/base.njk
title: Our Games
description: Explore games by Petrobolos Games.
---

<section class="relative overflow-hidden bg-slate-950 py-14">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/4 top-0 h-52 w-52 rounded-full bg-primary-500/20 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 h-56 w-56 rounded-full bg-cyan-400/15 blur-3xl"></div>
  </div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary-200">Our Games</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-white md:text-5xl">Three worlds in active development, each with its own identity.</h1>
    <p class="mt-4 max-w-2xl text-slate-300">
      We are intentionally focused: fewer projects, higher quality, and clearer platform strategy.
    </p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
  <div class="space-y-8">
    {% for game in games %}
    <article id="{{ game.id }}" class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900 scroll-mt-24">
      <div class="grid gap-0 md:grid-cols-[1.2fr_1fr]">
        <div class="relative min-h-[220px] overflow-hidden">
          <img src="{{ game.image }}" alt="{{ game.title }} key art" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105">
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-slate-950/30 to-transparent"></div>
          <div class="relative flex h-full items-end p-6">
            <span class="inline-flex rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-900">{{ game.status or 'In Development' }}</span>
          </div>
        </div>

        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">{{ game.subtitle }}</p>
          <h2 class="mt-2 text-2xl font-extrabold text-slate-900 dark:text-white">{{ game.title }}</h2>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{{ game.description }}</p>

          {% if game.platforms %}
          <div class="mt-5">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Target Platforms</p>
            <div class="flex flex-wrap gap-2">
              {% for platform_id in game.platforms %}
              {% set platform = platforms[platform_id] %}
              {% if platform %}
              <span class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                <img src="{{ platform.icon }}" alt="" class="h-3.5 w-3.5 object-contain dark:invert" aria-hidden="true" loading="lazy" decoding="async">
                {{ platform.name }}
              </span>
              {% endif %}
              {% endfor %}
            </div>
          </div>
          {% endif %}

          <div class="mt-6">
            <a href="{{ game.url }}" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-500">Open project<span aria-hidden="true" class="ml-1">→</span></a>
          </div>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
