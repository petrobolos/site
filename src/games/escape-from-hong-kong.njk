---
layout: layouts/base.njk
title: Escape from Hong Kong
description: Explore Escape from Hong Kong with gameplay highlights, screenshots, trailers, and platform availability.
---
{% if not projectPagesEnabled %}
<section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6 lg:px-8">
  <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Project Page Coming Soon</h1>
  <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">Redirecting to the games page.</p>
  <p class="mt-6">
    <a href="/games/" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-500">
      Go to Games
    </a>
  </p>
  <meta http-equiv="refresh" content="0;url=/games/">
  <script>
    window.location.replace('/games/');
  </script>
</section>
{% else %}
{% set project = projects["escape-from-hong-kong"] %}
{% from "components/project-sections.njk" import project_hero, feature_grid, screenshots_section, media_section, platforms_section %}

{{ project_hero(project) }}
{{ feature_grid(project.features) }}
{{ screenshots_section(project.screenshots) }}
{{ media_section(project.media) }}
{{ platforms_section(project.platforms, platforms, storefronts) }}
{% endif %}
