---
layout: layouts/base.njk
title: Home
description: Welcome to Petrobolos Games. Discover our worlds and latest news.
---

<section class="relative">
  <div class="relative isolate">
    <img src="/static/petrobolos-silver.avif" alt="Petrobolos placeholder image" class="w-full h-[40vh] md:h-[60vh] object-cover">
    <div class="absolute inset-0 bg-slate-900/50"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="text-center px-4">
        <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight">Petrobolos Games</h1>
        <p class="mt-4 text-slate-200 max-w-2xl mx-auto">Indie studio tagline placeholder. Bold adventures await.</p>
        <div class="mt-6 flex items-center justify-center gap-4">
          <a href="/games/" class="inline-flex items-center rounded-md bg-primary-600 px-5 py-3 text-white font-semibold hover:bg-primary-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-600">Explore Our Games</a>
          <a href="#latest" class="inline-flex items-center rounded-md bg-white/10 px-5 py-3 text-white font-semibold hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Latest News</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section aria-labelledby="nimbus-heading" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
  <div class="grid md:grid-cols-2 gap-10 items-center">
    <div>
      <h2 id="nimbus-heading" class="text-2xl md:text-3xl font-bold text-slate-900">Project Nimbus</h2>
      <p class="mt-3 text-lg text-slate-600">A short subtitle placeholder.</p>
      <p class="mt-4 text-slate-700">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vitae tortor non lorem scelerisque viverra. Sed a placerat sapien. Integer sit amet lorem non sem dapibus laoreet. Placeholder text.</p>
      <div class="mt-6">
        <a href="/games/#project-nimbus" class="text-primary-700 hover:text-primary-800 font-semibold">Learn more<span aria-hidden="true"> →</span></a>
      </div>
    </div>
    <div>
      <div class="aspect-w-16 aspect-h-9">
        <img src="/static/petrobolos-silver.avif" alt="Project Nimbus placeholder image" class="w-full h-full object-cover rounded-lg shadow">
      </div>
    </div>
  </div>
</section>

<section id="latest" aria-labelledby="latest-heading" class="bg-slate-50 py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 id="latest-heading" class="text-2xl md:text-3xl font-bold text-slate-900">Latest News</h2>
        <p class="mt-2 text-slate-600">Updates from the Petrobolos Games team.</p>
      </div>
      <a href="#" class="text-primary-700 hover:text-primary-800 font-semibold">View all<span aria-hidden="true"> →</span></a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for i in [1,2,3] %}
      <article class="bg-white rounded-lg shadow-sm ring-1 ring-slate-200 overflow-hidden">
        <img src="/static/petrobolos-silver.avif" alt="News {{ i }} placeholder image" class="w-full h-40 object-cover">
        <div class="p-5">
          <h3 class="text-lg font-semibold text-slate-900"><a href="#" class="hover:underline">News headline placeholder {{ i }}</a></h3>
          <p class="mt-2 text-sm text-slate-600 line-clamp-3">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer ac dui vitae augue egestas interdum. Suspendisse potenti.</p>
          <div class="mt-4 text-sm text-slate-500">Sep 23, 2025</div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
