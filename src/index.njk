---
layout: layouts/base.njk
title: Home
description: Welcome to Petrobolos Games. Discover our worlds and latest news.
---

<section class="relative overflow-hidden">
  <div class="relative isolate">
    <img
      src="{{ featured.background }}"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover blur-sm scale-105"
    >

    {# Gradient overlay #}
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/50 to-slate-900/90"></div>

    {# Foreground content #}
    <div class="relative grid grid-cols-1 md:grid-cols-2 items-center px-6 py-32 md:py-48 max-w-7xl mx-auto gap-12">

      {# Left: Text content #}
      <div class="text-center md:text-left z-10">
        <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight drop-shadow-lg">
          {{ featured.title }}
        </h1>
        <p class="mt-6 text-lg md:text-xl text-slate-200 max-w-xl md:mx-0 mx-auto drop-shadow">
          {{ featured.subtitle }}
        </p>

        <div class="mt-10 flex flex-col sm:flex-row md:justify-start justify-center items-center gap-4">
          <a
            href="{{  featured.url }}"
            class="inline-flex items-center rounded-md bg-primary-600 px-6 py-3 text-white font-semibold hover:bg-primary-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 transition-all"
          >
            Check it out
          </a>
        </div>
      </div>

      {# Right: Game box art #}
      <div class="flex justify-center md:justify-end z-10">
        <img
          src="{{ featured.image }}"
          alt="{{  featured.title }} artwork"
          class="w-64 md:w-80 lg:w-96 rounded-xl object-contain"
        >
      </div>

    </div>
  </div>
</section>

<section aria-labelledby="game-heading" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
  <div class="grid md:grid-cols-2 gap-10 items-center">
    <div>
      <h2 id="game-heading" class="text-2xl md:text-3xl font-bold text-slate-900">Project Nimbus</h2>
      <p class="mt-3 text-lg text-slate-600">A short subtitle placeholder.</p>
      <p class="mt-4 text-slate-700">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vitae tortor non lorem scelerisque viverra. Sed a placerat sapien. Integer sit amet lorem non sem dapibus laoreet. Placeholder text.</p>
      <div class="mt-6">
        <a href="/games/#project-nimbus" class="text-primary-700 hover:text-primary-800 font-semibold">Learn more<span aria-hidden="true"> →</span></a>
      </div>
    </div>
    <div>
      <div class="aspect-w-16 aspect-h-9">
        <img src="/static/petrobolos-silver.webp" alt="Project Nimbus placeholder image" class="w-full h-full object-cover rounded-lg shadow">
      </div>
    </div>
  </div>
</section>

<section id="latest" aria-labelledby="latest-heading" class="bg-slate-50 py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 id="latest-heading" class="text-2xl md:text-3xl font-bold text-slate-900">Latest News</h2>
        <p class="mt-2 text-slate-600">Updates from the Petrobolos Games team.</p>
      </div>
      <a href="#" class="text-primary-700 hover:text-primary-800 font-semibold">View all<span aria-hidden="true"> →</span></a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for i in [1,2,3] %}
      <article class="bg-white rounded-lg shadow-sm ring-1 ring-slate-200 overflow-hidden">
        <img src="/static/petrobolos-silver.webp" alt="News {{ i }} placeholder image" class="w-full h-40 object-cover">
        <div class="p-5">
          <h3 class="text-lg font-semibold text-slate-900"><a href="#" class="hover:underline">News headline placeholder {{ i }}</a></h3>
          <p class="mt-2 text-sm text-slate-600 line-clamp-3">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer ac dui vitae augue egestas interdum. Suspendisse potenti.</p>
          <div class="mt-4 text-sm text-slate-500">Sep 23, 2025</div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
